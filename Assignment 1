/*Ques 5-Explain the types of operators in codes
Ans 5- answer is given in code form:-*/
    #include <stdio.h>

int main() {
    int a = 10, b = 3, result;

    printf("===== 1. Arithmetic Operators =====\n");
    printf("a + b = %d\n", a + b);
    printf("a - b = %d\n", a - b);
    printf("a * b = %d\n", a * b);
    printf("a / b = %d\n", a / b);
    printf("a %% b = %d\n", a % b);

    printf("\n===== 2. Relational Operators =====\n");
    printf("a == b : %d\n", a == b);
    printf("a != b : %d\n", a != b);
    printf("a > b  : %d\n", a > b);
    printf("a < b  : %d\n", a < b);
    printf("a >= b : %d\n", a >= b);
    printf("a <= b : %d\n", a <= b);

    printf("\n===== 3. Logical Operators =====\n");
    printf("(a > 5 && b < 5) : %d\n", (a > 5 && b < 5));
    printf("(a > 5 || b > 5) : %d\n", (a > 5 || b > 5));
    printf("!(a == b) : %d\n", !(a == b));

    printf("\n===== 4. Assignment Operators =====\n");
    result = a;
    result += b;
    printf("result += b : %d\n", result);
    result -= b;
    printf("result -= b : %d\n", result);
    result *= b;
    printf("result *= b : %d\n", result);
    result /= b;
    printf("result /= b : %d\n", result);

    printf("\n===== 5. Increment and Decrement Operators =====\n");
    printf("a before increment: %d\n", a);
    a++;
    printf("After a++: %d\n", a);
    a--;
    printf("After a--: %d\n", a);

    printf("\n===== 6. Bitwise Operators =====\n");
    printf("a & b = %d\n", a & b);
    printf("a | b = %d\n", a | b);
    printf("a ^ b = %d\n", a ^ b);
    printf("~a = %d\n", ~a);
    printf("a << 1 = %d\n", a << 1);
    printf("a >> 1 = %d\n", a >> 1);

    printf("\n===== 7. Conditional (Ternary) Operator =====\n");
    result = (a > b) ? a : b;
    printf("Greater value = %d\n", result);

    printf("\n===== 8. Special Operator (sizeof) =====\n");
    printf("sizeof(a) = %lu bytes\n", sizeof(a));

    return 0;
}
